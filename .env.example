# ── MiniPlane Docker 部署环境变量 ──────────────────────────────────

# Django
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_HOSTS=*

# Database (Docker 内部使用 service 名称)
DB_NAME=miniplane
DB_USER=miniplane
DB_PASSWORD=miniplane
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=miniplane-attachments

# ── 公网配置 ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://192.168.31.2:8080
NGINX_PORT=8080

# ── 如需外部工具连接数据库/Redis，取消注释下方端口 ──────────
# DB_PORT=5432
# REDIS_PORT=6379
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
